# Copy to .env to change settings:   cp .env.example .env
# Every value is optional: docker-compose.yml has the same defaults.

# --- Security ---
JWT_SECRET=change-me-in-production

# --- Replication (PostgreSQL) ---
# The read replica applies changes this late ON PURPOSE, so replication lag
# is visible on a laptop (real lag here would be a few milliseconds).
REPLICA_APPLY_DELAY=2s
# Route a user's reads to the primary until the replica has their changes.
# Set to "off" to see the "where did my poll go?" bug.
READ_YOUR_WRITES=on

# --- Votes (MongoDB) ---
# How many replica-set members must confirm a vote: majority | 1 | 2 | 3
VOTE_WRITE_CONCERN=majority
VOTE_WRITE_TIMEOUT_MS=5000
# Hard limit for one vote, including waiting for a new primary to be elected
VOTE_TIMEOUT_MS=8000
# Counter documents per (poll, option, region). More = less contention.
COUNTER_SHARDS=16

# --- Live results ---
CACHE_RESULTS_TTL_MS=1000
LIVE_RESULTS_INTERVAL_MS=1000

# --- Rate limits ---
# Nginx, per IP
EDGE_RATE_LIMIT_RPS=100
EDGE_RATE_LIMIT_BURST=200
# per user: burst
RL_VOTES_CAPACITY=5
# per user: tokens per second
RL_VOTES_REFILL=1
# per IP
RL_LOGIN_CAPACITY=20
RL_LOGIN_REFILL=2
# per user: new polls
RL_CREATE_CAPACITY=5
RL_CREATE_REFILL=0.1
# if Redis is down: open (allow) or closed (503)
RATE_LIMIT_FAIL_MODE=open
