# Load-test / demo profile:  docker compose --env-file .env.loadtest up -d
#
# Load tests and the failover demo sign in hundreds of users from ONE machine
# (one IP address). This profile lifts only the per-IP limits (Nginx edge
# limit and the login limit). Per-USER vote limits stay exactly as normal,
# because every virtual voter is a separate account.
EDGE_RATE_LIMIT_RPS=100000
EDGE_RATE_LIMIT_BURST=100000
RL_LOGIN_CAPACITY=100000
RL_LOGIN_REFILL=100000
